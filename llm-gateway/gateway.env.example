# Copy to gateway.env and fill in. gateway.env is gitignored and should be chmod 600.
#
#   cp llm-gateway/gateway.env.example llm-gateway/gateway.env
#   chmod 600 llm-gateway/gateway.env

# Base URL of the in-house OpenAI-compatible gateway, including the version prefix
# it actually serves (run ./llm-gateway/probe.py to find out — usually /v1).
INHOUSE_LLM_BASE_URL=http://im-light-prd.example.internal/v1

# Bearer token for the gateway.
INHOUSE_LLM_TOKEN=replace-me

# Model the gateway serves, used for normal turns.
INHOUSE_LLM_MODEL=admin

# Model used for cheap background work (titles, summaries). Same model is fine.
INHOUSE_LLM_SMALL_MODEL=admin

# Local-only key that Claude Code uses to talk to the proxy. Any string; it never
# leaves your machine.
LITELLM_MASTER_KEY=sk-claude-box-local
